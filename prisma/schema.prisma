generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  INVOICE
  QUOTATION
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  ACCEPTED
  DECLINED
}

enum Currency {
  LKR
  USD
}

enum LeadStatus {
  NEW
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum ProjectPhase {
  MAP
  DESIGN
  BUILD
  OPERATE
}

enum AvailabilityStatus {
  OPEN
  LIMITED
  FULL
}

model Client {
  id        String     @id @default(uuid())
  name      String
  email     String
  company   String
  address   String
  country   String
  notes     String?
  createdAt DateTime   @default(now())
  documents Document[]
  projects  Project[]
}

model Document {
  id              String         @id @default(uuid())
  type            DocumentType
  number          String         @unique
  status          DocumentStatus @default(DRAFT)
  currency        Currency
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  projectName     String
  lineItems       Json
  subtotal        Float
  total           Float
  paymentSchedule Json
  notes           String?
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  validUntil      DateTime?
  convertedFromId String?
  reminderSent    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AdminSession {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String
  company     String?
  projectType String
  problem     String
  timeline    String
  budget      String
  referral    String?
  status      LeadStatus @default(NEW)
  value       Float?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Project {
  id         String        @id @default(uuid())
  name       String
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  phase      ProjectPhase  @default(MAP)
  startDate  DateTime?
  endDate    DateTime?
  value      Float?
  notes      String?
  sprintLogs SprintLog[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model SprintLog {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model SiteSettings {
  id           String             @id @default("singleton")
  availability AvailabilityStatus @default(OPEN)
  updatedAt    DateTime           @updatedAt
}
